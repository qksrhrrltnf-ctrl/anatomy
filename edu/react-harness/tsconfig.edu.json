{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@edu/*": [
        "../anatomy/edu/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "src/harness/*-ko.tsx",
    "src/harness/mount-edu.tsx",
    "../anatomy/edu/react/*.tsx",
    "../anatomy/edu/test-rig/*.ts",
    "../anatomy/edu/test-rig/*.tsx",
    "../anatomy/edu/spot-plate/*.ts",
    "../anatomy/edu/spot-plate/*.tsx"
  ],
  "exclude": []
}
